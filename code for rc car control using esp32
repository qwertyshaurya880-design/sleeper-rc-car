#include <WiFi.h>
#include <WebServer.h>
#include <ESP32Servo.h>

const char* ssid = "ESP32_RC_Car";
const char* password = "password123";

WebServer server(80);

Servo esc;
Servo steeringServo;

const int escPin = 18;
const int servoPin = 19;

const int ESC_NEUTRAL = 1500;
const int ESC_FORWARD = 1700; 
const int ESC_BACKWARD = 1300; 

const int STEERING_CENTER = 90;
const int STEERING_LEFT = 60;
const int STEERING_RIGHT = 120;

const char webpage[] PROGMEM = R"rawliteral(
<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>ESP32 Sim Rig</title>
  <style>
    body {
      background: radial-gradient(circle, #1a1a1a 0%, #0d0d0d 100%);
      color: #00ffcc;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      text-align: center;
      margin: 0;
      padding: 10px;
      overflow: hidden;
      touch-action: none;
    }
    .hud-container {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      max-width: 600px;
      margin: 20px auto;
      background: rgba(20, 20, 20, 0.85);
      border: 2px solid #333;
      border-radius: 15px;
      padding: 20px;
      box-shadow: 0 0 20px rgba(0, 255, 204, 0.1);
    }
    h2 {
      grid-column: span 2;
      margin: 0 0 10px 0;
      letter-spacing: 2px;
      font-size: 22px;
      text-transform: uppercase;
      color: #fff;
      text-shadow: 0 0 10px #00ffcc;
    }
    .control-group {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .game-btn {
      background: linear-gradient(135deg, #222 0%, #111 100%);
      color: #fff;
      border: 2px solid #00ffcc;
      padding: 25px 0;
      font-size: 18px;
      font-weight: bold;
      border-radius: 10px;
      cursor: pointer;
      box-shadow: inset 0 0 10px rgba(0,255,204,0.2);
      transition: 0.1s;
      user-select: none;
    }
    .game-btn:active, .game-btn.pressed {
      background: #00ffcc;
      color: #000;
      box-shadow: 0 0 15px #00ffcc;
    }
    .steering-row {
      display: flex;
      gap: 10px;
    }
    .steering-row .game-btn {
      flex: 1;
    }
  </style>
</head>
<body>
  <div class="hud-container">
    <h2>Telemetry // RC Unit</h2>
    
    <!-- Throttle Section -->
    <div class="control-group">
      <button class="game-btn" ontouchstart="sendCmd('/forward')" ontouchend="sendCmd('/stop')" onmousedown="sendCmd('/forward')" onmouseup="sendCmd('/stop')">THR+</button>
      <button class="game-btn" ontouchstart="sendCmd('/backward')" ontouchend="sendCmd('/stop')" onmousedown="sendCmd('/backward')" onmouseup="sendCmd('/stop')">THR-</button>
    </div>

    <!-- Steering Section -->
    <div class="control-group" style="justify-content: center;">
      <div class="steering-row">
        <button class="game-btn" ontouchstart="sendCmd('/left')" ontouchend="sendCmd('/center')" onmousedown="sendCmd('/left')" onmouseup="sendCmd('/center')">STR &lt;</button>
        <button class="game-btn" ontouchstart="sendCmd('/right')" ontouchend="sendCmd('/center')" onmousedown="sendCmd('/right')" onmouseup="sendCmd('/center')">STR &gt;</button>
      </div>
    </div>
  </div>

  <script>
    function sendCmd(path) {
      fetch(path).catch(err => console.log(err));
    }
  </script>
</body>
</html>
)rawliteral";

void handleRoot() { server.send(200, "text/html", webpage); }
void handleForward() { esc.writeMicroseconds(ESC_FORWARD); server.send(200, "text/plain", "Fwd"); }
void handleBackward() { esc.writeMicroseconds(ESC_BACKWARD); server.send(200, "text/plain", "Rev"); }
void handleStop() { esc.writeMicroseconds(ESC_NEUTRAL); server.send(200, "text/plain", "Neutral"); }
void handleLeft() { steeringServo.write(STEERING_LEFT); server.send(200, "text/plain", "Left"); }
void handleRight() { steeringServo.write(STEERING_RIGHT); server.send(200, "text/plain", "Right"); }
void handleCenter() { steeringServo.write(STEERING_CENTER); server.send(200, "text/plain", "Center"); }

void setup() {
  Serial.begin(115200);

  ESP32PWM::allocateTimer(0);
  ESP32PWM::allocateTimer(1);
  ESP32PWM::allocateTimer(2);
  ESP32PWM::allocateTimer(3);

  esc.setPeriodHertz(50);
  esc.attach(escPin, 1000, 2000);
  
  steeringServo.setPeriodHertz(50);
  steeringServo.attach(servoPin, 500, 2400);

  // Force clean startup state
  esc.writeMicroseconds(ESC_NEUTRAL);
  steeringServo.write(STEERING_CENTER);

  WiFi.softAP(ssid, password);
  
  server.on("/", handleRoot);
  server.on("/forward", handleForward);
  server.on("/backward", handleBackward);
  server.on("/stop", handleStop);
  server.on("/left", handleLeft);
  server.on("/right", handleRight);
  server.on("/center", handleCenter);

  server.begin();
}

void loop() {
  server.handleClient();
}
